# Environment mapping
ENVIRONMENT=development

# Database connection pool settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bharatvoice
REDIS_URL=redis://localhost:6379/0

# App Secret Key for JWTs
SECRET_KEY=super_secret_key_change_in_production

# VAPI Keys (Sprint 2)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# Deepgram (Sprint 2 STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs (Sprint 2 TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI (AI Logic)
OPENAI_API_KEY=your_openai_api_key_here

# Aadhaar Sandbox (Sprint 3)
AADHAAR_CLIENT_ID=your_aadhaar_client_id_here
AADHAAR_CLIENT_SECRET=your_aadhaar_client_secret_here

# AWS (S3 for objects, etc)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1

# Razorpay (Sprint 5)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Qdrant (Sprint 4 Vector DB)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Pathway (Sprint 4 Streaming)
PATHWAY_API_KEY=your_pathway_api_key_here

# Celery details
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=BharatVoice
